{
  "name": "oh-my-gold/pikpak-web-storage",
  "type": "library",
  "description": "PikPak Drive filesystem adapter for Laravel Storage and Flysystem 3",
  "keywords": [
    "laravel",
    "filesystem",
    "flysystem",
    "pikpak",
    "storage"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.5",
    "illuminate/filesystem": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "league/flysystem": "^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.5 || ^11.5",
    "illuminate/cache": "^10.0 || ^11.0 || ^12.0",
    "illuminate/config": "^10.0 || ^11.0 || ^12.0",
    "illuminate/container": "^10.0 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "OhMyGold\\PikPakWebStorage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OhMyGold\\PikPakWebStorage\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "OhMyGold\\PikPakWebStorage\\PikPakWebStorageServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "test:path-cache": "php tests/run.php",
    "test:live": "php tests/live.php"
  }
}
